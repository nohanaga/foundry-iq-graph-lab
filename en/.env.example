# Foundry IQ endpoint: tests 1 and 2 publication. Models: tests 1, 2 build, and 3-B.
# Storage accounts are required only for the Entity Graph build in test 1.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
# Entity Graph source: HNS disabled, blob soft delete enabled, blob versioning disabled.
# https://learn.microsoft.com/azure/search/agentic-knowledge-source-how-to-entity-graph#prerequisites
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<source-storage-account>
# Enrichment cache: general-purpose v2 (StorageV2) account.
# https://learn.microsoft.com/azure/search/enrichment-cache-how-to-configure#prerequisites
AZURE_CACHE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<cache-storage-account>

# Optional: set base model names when deployment names differ from model names.
# AZURE_OPENAI_MODEL=<chat-model-name>
# AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required for functional test 3-B. Use the actual deployment pricing in USD per 1M tokens.
# MODEL_INPUT_PRICE_PER_1M=<input-price>
# MODEL_OUTPUT_PRICE_PER_1M=<output-price>

# Download and place the Foundry IQ runtime manually before test 3 or test 1 external JSON-LD.
# Default: .\foundry-iq-skills beside the notebooks. This repository does not bundle it.
# Override with the downloaded plugin root (the directory containing graph), not graph\runtime.
# FOUNDRY_IQ_PLUGIN_ROOT=D:\path\to\foundry-iq-skills
# Optional native Topic Graph executable override.
# TOPICGRAPH_EXE=D:\path\to\topicgraph.exe
